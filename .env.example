# ---------------------------------------------------------------------------
# Copy to .env at the repo root:  cp .env.example .env
# Every workspace reads this single root .env file.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (packages/db + apps/backend) ---------------------------------
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/container_man

# --- Cache (packages/cache + apps/backend) ---------------------------------
# Optional. Leave it unset and the app runs with no cache; every cached read simply
# falls through to its source. Matches the redis service in docker-compose.yml.
# REDIS_URL=redis://localhost:6379

# Namespaces every cache key, so environments can share one Redis instance.
REDIS_KEY_PREFIX=container-man

# --- Backend (apps/backend) ------------------------------------------------
PORT=3001

# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me-min-32-chars

# Accepts values like 15m, 1h, 7d.
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Origin allowed to send credentialed requests to the backend.
WEB_ORIGIN=http://localhost:3000

# Cookie scope. Leave COOKIE_DOMAIN empty for localhost; in production set it to
# the shared parent domain (e.g. .example.com) so admin.* and api.* both see it.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Seed (pnpm db:seed) ---------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=password123
SEED_ADMIN_NAME=Admin

# Demo roles and accounts to click around with. Unset follows NODE_ENV — created in
# development, skipped in production, where a shared published password has no business
# existing. Set explicitly to override either way.
SEED_DEMO=true
SEED_DEMO_PASSWORD=password123

# --- Admin app (apps/admin-app) --------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001
